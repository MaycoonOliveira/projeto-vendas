# ============================================================================
# Variáveis de ambiente — Casa Carram
# Copie para .env.local e ajuste os valores. .env.local NUNCA é commitado.
# Segredos jamais usam o prefixo NEXT_PUBLIC_ (esse prefixo vaza para o cliente).
# ============================================================================

# URL pública do site (sem barra no final). Usada em canonical, OG e sitemap.
NEXT_PUBLIC_SITE_URL=https://www.casacarram.com.br

# ----------------------------------------------------------------------------
# Banco de dados — Supabase (PostgreSQL). Usado APENAS como banco (sem Supabase Auth/RLS).
# ----------------------------------------------------------------------------
# DATABASE_URL: conexão de RUNTIME da aplicação via pooler de TRANSAÇÃO (Supavisor, porta 6543).
#   O cliente usa `prepare: false` por causa do transaction pooling.
#   Supabase Dashboard → Project Settings → Database → Connection string → "Transaction pooler".
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-<region>.pooler.supabase.com:6543/postgres

# DIRECT_URL: conexão DIRETA / session mode (porta 5432), usada para MIGRATIONS (prepared
#   statements ok). Se ausente, o fluxo de migration cai para DATABASE_URL.
#   Supabase Dashboard → ... → "Session pooler" (5432) ou a conexão direta do projeto.
DIRECT_URL=postgresql://postgres.<project-ref>:<senha>@aws-<region>.pooler.supabase.com:5432/postgres

# ----------------------------------------------------------------------------
# Better Auth (Fase 2) — autenticação administrativa
# ----------------------------------------------------------------------------
# Segredo de assinatura de sessão. Gere um valor forte, ex.: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=troque-por-um-segredo-forte-de-32-bytes
# URL base da app (dev: http://localhost:3000; prod: a URL pública, sem barra no final).
BETTER_AUTH_URL=http://localhost:3000
